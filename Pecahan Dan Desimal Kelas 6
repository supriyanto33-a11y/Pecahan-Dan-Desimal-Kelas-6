            },
            {
                q: "Siti membeli gula 0,5 kg dan tepung 1,25 kg. Total berat belanjaan Siti adalah...",
                options: ["1,75 kg", "1,30 kg", "1,80 kg", "2,25 kg"],
                ans: 0,
                exp: "0,50 kg + 1,25 kg = 1,75 kg."
            },
            {
                q: "Ibu memiliki pita sepanjang 2,4 meter. Dipotong untuk kerajinan 1,15 meter. Sisa pita Ibu adalah...",
                options: ["1,35 meter", "1,25 meter", "1,15 meter", "0,85 meter"],
