<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dunia Seru Pecahan & Desimal - Kelas 6 SD</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brandYellow: '#FFD166',
                        brandPink: '#FF6B6B',
                        brandGreen: '#06D6A0',
                        brandBlue: '#118AB2',
                        brandPurple: '#8338EC',
                        brandOrange: '#FF9F1C'
                    },
                    fontFamily: {
                        fredoka: ['Fredoka', 'sans-serif'],
                        nunito: ['Nunito', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(135deg, #E0F7FA 0%, #FFF9C4 100%);
            min-height: 100vh;
        }
        h1, h2, h3, .font-fun {
            font-family: 'Fredoka', cursive;
        }
        .bouncy {
            transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .bouncy:hover {
            transform: scale(1.05) rotate(-1deg);
        }
        .bouncy-active:active {
            transform: scale(0.95);
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 4px solid #FFFFFF;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #FF6B6B;
            border-radius: 10px;
        }
    </style>
</head>
<body class="text-slate-800 pb-12">

    <!-- Header -->
    <header class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b-4 border-yellow-400 shadow-sm">
        <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('materi')">
                <div class="bg-gradient-to-tr from-brandPink to-brandYellow text-white p-3 rounded-2xl shadow-lg transform -rotate-3">
                    <i class="fa-solid fa-pizza-slice text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-2xl md:text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-brandPink via-brandPurple to-brandBlue">
                        MatemaTika Ceria!
                    </h1>
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Bab 1: Pecahan & Desimal • Kelas 6 SD</p>
                </div>
            </div>

            <!-- Navigation Tabs -->
            <nav class="flex space-x-2 mt-3 sm:mt-0 w-full sm:w-auto justify-center">
                <button id="nav-materi" onclick="switchTab('materi')" class="nav-btn bg-brandPink text-white px-4 py-2.5 rounded-xl font-bold font-fun flex items-center gap-2 shadow-md hover:bg-red-500 transition">
                    <i class="fa-solid fa-shapes"></i> Materi & Visual
                </button>
                <button id="nav-langkah" onclick="switchTab('langkah')" class="nav-btn bg-white text-slate-700 px-4 py-2.5 rounded-xl font-bold font-fun flex items-center gap-2 hover:bg-yellow-100 transition border-2 border-slate-200">
                    <i class="fa-solid fa-list-check"></i> Langkah Solusi
                </button>
                <button id="nav-kuis" onclick="switchTab('kuis')" class="nav-btn bg-white text-slate-700 px-4 py-2.5 rounded-xl font-bold font-fun flex items-center gap-2 hover:bg-yellow-100 transition border-2 border-slate-200">
                    <i class="fa-solid fa-gamepad"></i> Kuis (20 Soal)
                </button>
            </nav>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-6xl mx-auto px-4 mt-6">

        <!-- SECTION 1: MATERI & VISUALISASI INTERAKTIF -->
        <section id="sec-materi" class="tab-content space-y-8">
            <!-- Banner Utama -->
            <div class="bg-gradient-to-r from-purple-500 via-pink-500 to-red-500 rounded-3xl p-6 md:p-8 text-white shadow-xl relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 opacity-20 text-9xl">
                    <i class="fa-solid fa-pie-chart"></i>
                </div>
                <div class="relative z-10 max-w-2xl">
                    <span class="bg-yellow-300 text-slate-900 font-extrabold text-xs px-3 py-1 rounded-full uppercase tracking-wider">Modul Belajar Seru</span>
                    <h2 class="text-3xl md:text-4xl font-extrabold mt-2 font-fun">Jelajahi Dunia Pecahan & Desimal! 🍕✨</h2>
                    <p class="mt-2 text-pink-100 text-lg">Pecahan adalah bagian dari keseluruhan, sedangkan Desimal adalah cara lain menuliskan pecahan persepuluhan, persatusan, dan seterusnya!</p>
                </div>
            </div>

            <!-- Interaktif Visualizer Pecahan vs Desimal -->
            <div class="glass-card rounded-3xl p-6 md:p-8">
                <div class="flex items-center gap-3 mb-6">
                    <span class="bg-brandBlue text-white p-2.5 rounded-xl"><i class="fa-solid fa-wand-magic-sparkles text-xl"></i></span>
                    <div>
                        <h3 class="text-2xl font-bold text-slate-800 font-fun">Laboratorium Visual Pecahan & Desimal</h3>
                        <p class="text-slate-500 text-sm">Geser atau ubah nilainya untuk melihat pizza pecahan dan bentuk desimalnya!</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
                    <!-- Controls & Graphic -->
                    <div class="bg-slate-50 p-6 rounded-2xl border-2 border-slate-200 text-center space-y-6">
                        <!-- Pizza Visual Canvas -->
                        <div class="relative w-48 h-48 mx-auto flex items-center justify-center">
                            <svg id="pizza-svg" viewBox="0 0 100 100" class="w-full h-full transform -rotate-90 filter drop-shadow-md">
                                <!-- JS will draw slices here -->
                            </svg>
                        </div>

                        <!-- Controls -->
                        <div class="space-y-4 max-w-xs mx-auto">
                            <div>
                                <label class="block text-xs font-bold text-slate-600 mb-1 uppercase">Pembilang (Bagian Terpakai): <span id="val-pembilang" class="text-brandPink font-extrabold text-lg">1</span></label>
                                <input type="range" id="input-pembilang" min="1" max="10" value="1" class="w-full accent-brandPink cursor-pointer" oninput="updateVisualizer()">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-600 mb-1 uppercase">Penyebut (Total Potongan): <span id="val-penyebut" class="text-brandBlue font-extrabold text-lg">4</span></label>
                                <input type="range" id="input-penyebut" min="1" max="10" value="4" class="w-full accent-brandBlue cursor-pointer" oninput="updateVisualizer()">
                            </div>
                        </div>
                    </div>

                    <!-- Visual Output Stats -->
                    <div class="space-y-4">
                        <div class="bg-gradient-to-r from-orange-100 to-yellow-100 p-5 rounded-2xl border-2 border-orange-200 flex items-center justify-between">
                            <div>
                                <span class="text-xs font-bold text-orange-600 uppercase tracking-wider">Bentuk Pecahan</span>
                                <div class="text-3xl font-black text-orange-700 font-fun flex items-center gap-2 mt-1">
                                    <span id="display-pecahan">1/4</span>
                                </div>
                            </div>
                            <i class="fa-solid fa-chart-pie text-4xl text-orange-400"></i>
                        </div>

                        <div class="bg-gradient-to-r from-teal-100 to-emerald-100 p-5 rounded-2xl border-2 border-teal-200 flex items-center justify-between">
                            <div>
                                <span class="text-xs font-bold text-teal-600 uppercase tracking-wider">Bentuk Desimal</span>
                                <div id="display-desimal" class="text-3xl font-black text-teal-700 font-fun mt-1">
                                    0.25
                                </div>
                            </div>
                            <i class="fa-solid fa-calculator text-4xl text-teal-400"></i>
                        </div>

                        <div class="bg-gradient-to-r from-purple-100 to-indigo-100 p-5 rounded-2xl border-2 border-purple-200 flex items-center justify-between">
                            <div>
                                <span class="text-xs font-bold text-purple-600 uppercase tracking-wider">Bentuk Persen (%)</span>
                                <div id="display-persen" class="text-3xl font-black text-purple-700 font-fun mt-1">
                                    25%
                                </div>
                            </div>
                            <i class="fa-solid fa-percent text-4xl text-purple-400"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Kartu Concept Warna-Warni -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Card 1: Pecahan Senilai -->
                <div class="glass-card rounded-2xl p-6 border-t-8 border-t-brandPink bouncy">
                    <div class="w-12 h-12 bg-pink-100 text-brandPink rounded-2xl flex items-center justify-center font-bold text-2xl mb-4">
                        1
                    </div>
                    <h4 class="text-xl font-bold font-fun text-slate-800 mb-2">Pecahan Senilai</h4>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Pecahan yang nilainya tidak berubah walaupun pembilang dan penyebut dikali atau dibagi dengan angka yang sama!
                    </p>
                    <div class="mt-4 bg-pink-50 p-3 rounded-xl border border-pink-200 text-center text-sm font-bold text-brandPink">
                        1/2 = 2/4 = 3/6 = 4/8
                    </div>
                </div>

                <!-- Card 2: Pecahan ke Desimal -->
                <div class="glass-card rounded-2xl p-6 border-t-8 border-t-brandYellow bouncy">
                    <div class="w-12 h-12 bg-yellow-100 text-yellow-600 rounded-2xl flex items-center justify-center font-bold text-2xl mb-4">
                        2
                    </div>
                    <h4 class="text-xl font-bold font-fun text-slate-800 mb-2">Mengubah ke Desimal</h4>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Ubah penyebut pecahan menjadi 10, 100, atau 1000, atau bisa juga dengan membagi pembilang dengan penyebutnya!
                    </p>
                    <div class="mt-4 bg-yellow-50 p-3 rounded-xl border border-yellow-200 text-center text-sm font-bold text-yellow-700">
                        3/5 = (3×2) / (5×2) = 6/10 = 0.6
                    </div>
                </div>

                <!-- Card 3: Desimal ke Pecahan -->
                <div class="glass-card rounded-2xl p-6 border-t-8 border-t-brandGreen bouncy">
                    <div class="w-12 h-12 bg-emerald-100 text-brandGreen rounded-2xl flex items-center justify-center font-bold text-2xl mb-4">
                        3
                    </div>
                    <h4 class="text-xl font-bold font-fun text-slate-800 mb-2">Desimal ke Pecahan</h4>
                    <p class="text-sm text-slate-600 leading-relaxed">
                        Hitung jumlah angka di belakang koma! 1 angka = /10, 2 angka = /100. Lalu sederhanakan pecahannya!
                    </p>
                    <div class="mt-4 bg-emerald-50 p-3 rounded-xl border border-emerald-200 text-center text-sm font-bold text-brandGreen">
                        0.75 = 75/100 = 3/4
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 2: LANGKAH-LANGKAH & SOLUSI -->
        <section id="sec-langkah" class="tab-content hidden space-y-8">
            <div class="bg-gradient-to-r from-blue-500 to-indigo-600 rounded-3xl p-6 md:p-8 text-white shadow-xl">
                <h2 class="text-3xl md:text-4xl font-extrabold font-fun">Panduan Langkah-Langkah Mengerjakan 🛠️</h2>
                <p class="text-blue-100 text-lg mt-2">Pahami trik dan langkah pasti dalam menyelesaikan soal matematika Bab 1!</p>
            </div>

            <!-- Accordion / Langkah-langkah Trik -->
            <div class="space-y-4">
                <!-- Trik 1 -->
                <div class="glass-card rounded-2xl p-6 border-l-8 border-l-brandPink">
                    <h3 class="text-xl font-bold font-fun text-slate-800 flex items-center gap-2">
                        <span class="bg-red-100 text-red-500 w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">A</span>
                        Mengurutkan Pecahan & Desimal
                    </h3>
                    <div class="mt-4 space-y-3 text-slate-600 text-sm md:text-base">
                        <div class="flex items-start gap-3 bg-white p-3 rounded-xl border border-slate-100">
                            <span class="bg-brandPink text-white font-bold rounded-lg px-2 py-0.5 text-xs mt-0.5">Langkah 1</span>
                            <p>Ubah semua bilangan (pecahan biasa, campuran, atau persen) menjadi **bentuk desimal** agar seragam.</p>
                        </div>
                        <div class="flex items-start gap-3 bg-white p-3 rounded-xl border border-slate-100">
                            <span class="bg-brandPink text-white font-bold rounded-lg px-2 py-0.5 text-xs mt-0.5">Langkah 2</span>
                            <p>Samakan jumlah digit di belakang koma dengan menambahkan angka 0 di paling belakang jika perlu (Contoh: 0.5 menjadi 0.50).</p>
                        </div>
                        <div class="flex items-start gap-3 bg-white p-3 rounded-xl border border-slate-100">
                            <span class="bg-brandPink text-white font-bold rounded-lg px-2 py-0.5 text-xs mt-0.5">Langkah 3</span>
                            <p>Bandingkan angkanya dari yang paling kiri (nilai tempat terbesar) lalu urutkan sesuai permintaan soal.</p>
                        </div>
                    </div>
                </div>

                <!-- Trik 2 -->
                <div class="glass-card rounded-2xl p-6 border-l-8 border-l-brandYellow">
                    <h3 class="text-xl font-bold font-fun text-slate-800 flex items-center gap-2">
                        <span class="bg-yellow-100 text-yellow-600 w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">B</span>
                        Penjumlahan & Pengurangan Desimal
                    </h3>
                    <div class="mt-4 space-y-3 text-slate-600 text-sm md:text-base">
                        <div class="flex items-start gap-3 bg-white p-3 rounded-xl border border-slate-100">
                            <span class="bg-brandYellow text-slate-900 font-bold rounded-lg px-2 py-0.5 text-xs mt-0.5">Langkah 1</span>
                            <p>Tulis angka secara bersusun ke bawah.</p>
                        </div>
                        <div class="flex items-start gap-3 bg-white p-3 rounded-xl border border-slate-100">
                            <span class="bg-brandYellow text-slate-900 font-bold rounded-lg px-2 py-0.5 text-xs mt-0.5">Langkah 2</span>
                            <p class="font-bold text-red-600">Paling Penting: Luruskan posisi tanda KOMA (,) dari semua bilangan!</p>
                        </div>
                        <div class="flex items-start gap-3 bg-white p-3 rounded-xl border border-slate-100">
                            <span class="bg-brandYellow text-slate-900 font-bold rounded-lg px-2 py-0.5 text-xs mt-0.5">Langkah 3</span>
                            <p>Lakukan penjumlahan/pengurangan seperti biasa dari kanan ke kiri, lalu turunkan tanda koma di posisi yang sejajar.</p>
                        </div>
                    </div>
                </div>

                <!-- Trik 3 -->
                <div class="glass-card rounded-2xl p-6 border-l-8 border-l-brandGreen">
                    <h3 class="text-xl font-bold font-fun text-slate-800 flex items-center gap-2">
                        <span class="bg-emerald-100 text-brandGreen w-8 h-8 rounded-full flex items-center justify-center text-sm font-black">C</span>
                        Perkalian & Pembagian Desimal
                    </h3>
                    <div class="mt-4 space-y-3 text-slate-600 text-sm md:text-base">
                        <div class="flex items-start gap-3 bg-white p-3 rounded-xl border border-slate-100">
                            <span class="bg-brandGreen text-white font-bold rounded-lg px-2 py-0.5 text-xs mt-0.5">Perkalian</span>
                            <p>Kalikan angka seolah-olah tidak ada koma. Setelah ketemu hasilnya, hitung total jumlah angka di belakang koma dari kedua bilangan dan terapkan pada hasil akhir.</p>
                        </div>
                        <div class="flex items-start gap-3 bg-white p-3 rounded-xl border border-slate-100">
                            <span class="bg-brandGreen text-white font-bold rounded-lg px-2 py-0.5 text-xs mt-0.5">Pembagian</span>
                            <p>Kalikan kedua bilangan dengan 10, 100, dst. sampai pembaginya menjadi bilangan bulat utuh, lalu bagikan secara bersusun (porogapit).</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 3: KUIS INTERAKTIF 20 SOAL -->
        <section id="sec-kuis" class="tab-content hidden space-y-6">
            <!-- Quiz Start Screen -->
            <div id="quiz-start" class="glass-card rounded-3xl p-8 text-center space-y-6 max-w-2xl mx-auto">
                <div class="w-24 h-24 bg-gradient-to-tr from-brandPink to-brandYellow rounded-full mx-auto flex items-center justify-center text-white text-5xl shadow-xl animate-bounce">
                    <i class="fa-solid fa-trophy"></i>
                </div>
                <div>
                    <h2 class="text-3xl font-extrabold font-fun text-slate-800">Uji Kemampuanmu! 🏆</h2>
                    <p class="text-slate-600 mt-2">Siap untuk menjadi Master Pecahan & Desimal? Ada **20 Soal Pilihan Ganda** menarik yang siap kamu selesaikan.</p>
                </div>
                <div class="bg-yellow-50 border-2 border-yellow-200 rounded-2xl p-4 text-left text-sm text-yellow-800 space-y-1">
                    <p class="font-bold"><i class="fa-solid fa-circle-info"></i> Petunjuk Kuis:</p>
                    <ul class="list-disc list-inside space-y-1 text-xs md:text-sm">
                        <li>Setiap jawaban benar mendapat 5 Poin (Total Nilai Maksimal: 100).</li>
                        <li>Pilihlah salah satu jawaban yang menurutmu paling tepat.</li>
                        <li>Penjelasan langsung diberikan setelah kamu memilih jawaban!</li>
                    </ul>
                </div>
                <button onclick="startQuiz()" class="w-full bg-gradient-to-r from-brandGreen to-teal-500 text-white py-4 rounded-2xl font-bold font-fun text-xl shadow-lg hover:brightness-110 transition bouncy bouncy-active">
                    Mulai Kuis Sekarang! 🚀
                </button>
            </div>

            <!-- Quiz Play Screen -->
            <div id="quiz-play" class="hidden max-w-3xl mx-auto space-y-6">
                <!-- Status Header -->
                <div class="flex justify-between items-center bg-white p-4 rounded-2xl border-2 border-slate-200 shadow-sm">
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-bold text-slate-500 uppercase">Soal:</span>
                        <span id="quiz-progress" class="font-black text-brandPink text-xl font-fun">1 / 20</span>
                    </div>
                    <!-- Progress Bar -->
                    <div class="w-1/3 bg-slate-200 h-3 rounded-full overflow-hidden">
                        <div id="quiz-bar" class="bg-brandPink h-full w-0 transition-all duration-300"></div>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-bold text-slate-500 uppercase">Skor:</span>
                        <span id="quiz-score" class="font-black text-brandGreen text-xl font-fun">0</span>
                    </div>
                </div>

                <!-- Question Card -->
                <div class="glass-card rounded-3xl p-6 md:p-8 space-y-6">
                    <h3 id="quiz-question" class="text-xl md:text-2xl font-extrabold text-slate-800 font-fun">
                        <!-- Question Text Here -->
                    </h3>

                    <!-- Options -->
                    <div id="quiz-options" class="grid grid-cols-1 gap-3">
                        <!-- Option buttons inserted by JS -->
                    </div>

                    <!-- Explanation Area -->
                    <div id="quiz-explanation" class="hidden p-4 rounded-2xl border-2 text-sm font-semibold space-y-1">
                        <!-- Feedback inserted by JS -->
                    </div>

                    <!-- Next Button -->
                    <button id="btn-next" onclick="nextQuestion()" class="hidden w-full bg-brandBlue text-white py-3.5 rounded-2xl font-bold font-fun text-lg hover:bg-blue-600 transition bouncy">
                        Lanjut ke Soal Berikutnya <i class="fa-solid fa-arrow-right ml-2"></i>
                    </button>
                </div>
            </div>

            <!-- Quiz Result Screen -->
            <div id="quiz-result" class="hidden glass-card rounded-3xl p-8 text-center space-y-6 max-w-xl mx-auto">
                <div id="result-icon" class="text-6xl">
                    <!-- Icon based on score -->
                </div>
                <div>
                    <h2 class="text-3xl font-black font-fun text-slate-800">Kuis Selesai! 🎉</h2>
                    <p class="text-slate-500 text-sm mt-1">Berikut adalah hasil pencapaian hebatmu:</p>
                </div>

                <div class="bg-slate-50 p-6 rounded-2xl border-2 border-slate-200 inline-block w-full">
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">NILAI AKHIR KAMU</span>
                    <div id="result-score" class="text-6xl font-black font-fun text-brandPink my-2">
                        100
                    </div>
                    <p id="result-message" class="text-slate-700 font-bold text-sm">
                        Luar Biasa! Kamu adalah Master Pecahan sejati!
                    </p>
                </div>

                <button onclick="startQuiz()" class="w-full bg-brandPink text-white py-3.5 rounded-2xl font-bold font-fun text-lg hover:bg-red-500 transition bouncy">
                    Coba Kuis Lagi 🔄
                </button>
            </div>
        </section>

    </main>

    <script>
        // --- 1. TAB NAVIGATION ---
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('bg-brandPink', 'text-white');
                btn.classList.add('bg-white', 'text-slate-700');
            });

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            const activeNav = document.getElementById(`nav-${tabId}`);
            activeNav.classList.remove('bg-white', 'text-slate-700');
            activeNav.classList.add('bg-brandPink', 'text-white');
        }

        // --- 2. VISUALIZER LOGIC (PIZZA SVG) ---
        function updateVisualizer() {
            let pembilang = parseInt(document.getElementById('input-pembilang').value);
            let penyebut = parseInt(document.getElementById('input-penyebut').value);

            // Pembilang tidak boleh lebih besar dari penyebut di demo ini
            if (pembilang > penyebut) {
                pembilang = penyebut;
                document.getElementById('input-pembilang').value = pembilang;
            }

            document.getElementById('val-pembilang').innerText = pembilang;
            document.getElementById('val-penyebut').innerText = penyebut;

            // Calculations
            const desimalVal = (pembilang / penyebut).toFixed(2);
            const persenVal = Math.round((pembilang / penyebut) * 100);

            document.getElementById('display-pecahan').innerText = `${pembilang} / ${penyebut}`;
            document.getElementById('display-desimal').innerText = desimalVal;
            document.getElementById('display-persen').innerText = `${persenVal}%`;

            // Draw SVG Slices
            const svg = document.getElementById('pizza-svg');
            svg.innerHTML = ''; // Clear SVG

            const cx = 50, cy = 50, r = 45;

            for (let i = 0; i < penyebut; i++) {
                const startAngle = (i * 360) / penyebut;
                const endAngle = ((i + 1) * 360) / penyebut;

                const x1 = cx + r * Math.cos((Math.PI * startAngle) / 180);
                const y1 = cy + r * Math.sin((Math.PI * startAngle) / 180);
                const x2 = cx + r * Math.cos((Math.PI * endAngle) / 180);
                const y2 = cy + r * Math.sin((Math.PI * endAngle) / 180);

                const largeArcFlag = endAngle - startAngle <= 180 ? 0 : 1;

                const d = `M ${cx} ${cy} L ${x1} ${y1} A ${r} ${r} 0 ${largeArcFlag} 1 ${x2} ${y2} Z`;

                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                path.setAttribute('d', d);
                path.setAttribute('stroke', '#FFFFFF');
                path.setAttribute('stroke-width', '2');

                // Color slices based on pembilang
                if (i < pembilang) {
                    path.setAttribute('fill', '#FF6B6B'); // Active slice color
                } else {
                    path.setAttribute('fill', '#E2E8F0'); // Inactive slice color
                }

                svg.appendChild(path);
            }
        }

        // --- 3. QUIZ DATA (20 QUESTIONS) ---
        const quizData = [
            {
