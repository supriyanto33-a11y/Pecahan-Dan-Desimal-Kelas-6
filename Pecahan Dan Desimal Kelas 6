        let currentQ = 0;
        let score = 0;
        let answered = false;

        function startQuiz() {
            currentQ = 0;
            score = 0;
            document.getElementById('quiz-start').classList.add('hidden');
            document.getElementById('quiz-result').classList.add('hidden');
            document.getElementById('quiz-play').classList.remove('hidden');
            showQuestion();
        }

        function showQuestion() {
            answered = false;
            const qData = quizData[currentQ];

            // Progress Update
            document.getElementById('quiz-progress').innerText = `${currentQ + 1} / ${quizData.length}`;
            document.getElementById('quiz-bar').style.width = `${((currentQ + 1) / quizData.length) * 100}%`;
            document.getElementById('quiz-score').innerText = score;

            // UI Reset
            document.getElementById('quiz-question').innerText = `${currentQ + 1}. ${qData.q}`;
            document.getElementById('quiz-explanation').classList.add('hidden');
            document.getElementById('btn-next').classList.add('hidden');

            // Render Options
            const optsContainer = document.getElementById('quiz-options');
            optsContainer.innerHTML = '';

            qData.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left p-4 rounded-2xl border-2 border-slate-200 hover:border-brandBlue hover:bg-blue-50 font-bold text-slate-700 transition flex items-center justify-between bouncy";
                btn.innerHTML = `
                    <span><strong class="text-brandBlue mr-2">${String.fromCharCode(65 + idx)}.</strong> ${opt}</span>
                    <i class="fa-regular fa-circle text-slate-300"></i>
                `;
                btn.onclick = () => selectAnswer(idx, btn);
                optsContainer.appendChild(btn);
            });
        }

        function selectAnswer(selectedIdx, btnElement) {
            if (answered) return;
            answered = true;

            const qData = quizData[currentQ];
            const allBtns = document.getElementById('quiz-options').children;
            const expBox = document.getElementById('quiz-explanation');

            if (selectedIdx === qData.ans) {
                // Jawaban Benar
                score += 5;
                document.getElementById('quiz-score').innerText = score;
                btnElement.classList.remove('border-slate-200', 'hover:bg-blue-50');
                btnElement.classList.add('bg-emerald-100', 'border-brandGreen', 'text-emerald-800');
                btnElement.querySelector('i').className = "fa-solid fa-circle-check text-brandGreen text-xl";

                expBox.className = "p-4 rounded-2xl border-2 bg-emerald-50 border-emerald-200 text-emerald-800 text-sm font-semibold space-y-1 block";
                expBox.innerHTML = `<p class="font-bold text-base"><i class="fa-solid fa-face-smile"></i> Jawabanmu Tepat Sekali!</p><p>${qData.exp}</p>`;
            } else {
                // Jawaban Salah
                btnElement.classList.remove('border-slate-200', 'hover:bg-blue-50');
                btnElement.classList.add('bg-red-100', 'border-brandPink', 'text-red-800');
                btnElement.querySelector('i').className = "fa-solid fa-circle-xmark text-brandPink text-xl";

                // Highlight Jawaban Benar
                const correctBtn = allBtns[qData.ans];
                correctBtn.classList.remove('border-slate-200');
                correctBtn.classList.add('bg-emerald-50', 'border-brandGreen', 'text-emerald-800');
                correctBtn.querySelector('i').className = "fa-solid fa-circle-check text-brandGreen text-xl";

                expBox.className = "p-4 rounded-2xl border-2 bg-red-50 border-red-200 text-red-800 text-sm font-semibold space-y-1 block";
                expBox.innerHTML = `<p class="font-bold text-base"><i class="fa-solid fa-face-sad-tear"></i> Ops, Belum Tepat!</p><p>${qData.exp}</p>`;
            }

            document.getElementById('btn-next').classList.remove('hidden');
        }

        function nextQuestion() {
            currentQ++;
            if (currentQ < quizData.length) {
                showQuestion();
            } else {
                showResult();
            }
        }

        function showResult() {
            document.getElementById('quiz-play').classList.add('hidden');
            document.getElementById('quiz-result').classList.remove('hidden');

            document.getElementById('result-score').innerText = score;

            const iconBox = document.getElementById('result-icon');
            const msgBox = document.getElementById('result-message');

            if (score >= 80) {
                iconBox.innerHTML = "🏆✨";
                msgBox.innerText = "Luar biasa! Kamu sangat mahir dalam pecahan dan desimal!";
                confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
            } else if (score >= 60) {
                iconBox.innerHTML = "🌟👏";
                msgBox.innerText = "Bagus sekali! Sedikit latihan lagi kamu pasti dapat nilai sempurna!";
            } else {
                iconBox.innerHTML = "📚💪";
                msgBox.innerText = "Jangan berkecil hati! Pelajari kembali materi dan coba lagi ya!";
            }
        }

        // Initialize visualizer on page load
        window.onload = function() {
            updateVisualizer();
        };
    </script>
